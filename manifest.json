{
  "manifest_version": 3,
  "name": "Sponsor Skipper",
  "version": "1.1.1",
"icons": { "16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png" },  "description": "Skips sponsor segments in YouTube videos using chapter markers. Leaves YouTube ads alone.",
  "permissions": ["storage", "activeTab", "tabs"],
  "host_permissions": ["https://sponsor.ajay.app/*"],
  "action": { "default_popup": "popup.html", "default_title": "Sponsor Skipper", "default_icon": { "16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png" } },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "commands": {
    "toggle": { "suggested_key": { "default": "Alt+Shift+S" }, "description": "Toggle Sponsor Skipper" },
    "undo": { "suggested_key": { "default": "Alt+Shift+U" }, "description": "Undo last skip" }
  }
}